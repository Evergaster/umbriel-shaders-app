{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Umbriel Shaders",
  "version": "0.1.0",
  "identifier": "dev.barrulus.umbrielshaders",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Umbriel Shaders",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "decorations": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0A0A0A"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Browse and apply Umbriel shaders",
    "longDescription": "Browse your animation library, preview shaders live, and apply them to Umbriel effect slots.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
